# dsh-stock-jt 部署参数模板（黑箱不打包，部署机填入；复制为 config/runtime.env）
# 推荐在 设置 → 技术面研判 → 环境设置 页维护（服务端原子写 + token 脱敏）。

# 数据源（复选框选择，逗号分隔）：
#   vipdoc,tdxmcp  = 本地通达信 + 云端 MCP 都可用（双源）
#   vipdoc         = 仅本地通达信
#   tdxmcp         = 仅云端 MCP
KLINE_SOURCES=vipdoc,tdxmcp

# 通达信根目录（勾选 vipdoc 时必填）：vipdoc / gbbq 由 TDX_ROOT 内部子目录推导
#   vipdoc = TDX_ROOT/vipdoc
#   gbbq   = TDX_ROOT/T0002/hq_cache/gbbq
# TDX_ROOT=

# 通达信云端 MCP token（勾选 tdxmcp 时必填）——无通用 token，用户自备，机密禁入库
# TDX_MCP_TOKEN=

# chanlun64.dll 已随包 vendor/ 分发，无需配置

# Python 依赖（struct_calc.py 取数需要）：numpy / pandas / requests
# 可选 venv python.exe（留空则用当前解释器；缺依赖时按工作提示词「本地环境依赖检查与安装」手动装）
# VENV_PYTHON=
